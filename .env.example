# ==============================================================================
# SIDPREP 2.0 PRODUCTION & LOCAL ENVIRONMENT TEMPLATE
# Copy to `.env` on your deployment server: `cp .env.example .env`
# ==============================================================================

# Node Environment
NODE_ENV=production

# Database (PostgreSQL 16)
POSTGRES_USER=sidprep_user
POSTGRES_PASSWORD=generate_a_random_secure_password_here_32chars_min
POSTGRES_DB=sidprep_db

# Ports (Internal Docker Mappings)
PORT=4000
WEB_PORT=3000

# Authentication & Cryptographic Secrets (MUST be >= 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=generate_strong_random_jwt_secret_at_least_32_characters_long_min
JWT_REFRESH_SECRET=generate_strong_random_refresh_secret_at_least_32_chars_long
ADMIN_SESSION_SECRET=generate_strong_random_admin_session_cookie_secret_key

# Admin Master Credentials
ADMIN_EMAIL=sksakirhossain8@gmail.com
ADMIN_PASSWORD=AdminSecurePass123!

# CORS Whitelist (Comma-separated)
CORS_ALLOWED_ORIGINS=https://sidprep.in,https://api.sidprep.in,http://localhost:3000

# Email Gateway (Brevo SMTP Relay)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=c0cb63001@smtp-brevo.com
BREVO_SMTP_PASS=xsmtpsib-97074ae277161f493015be656141d02456dbb898dce704165e72d529213940fd-LSNXeocw1KG8vYNm
BREVO_SENDER_EMAIL=no-reply@sidprep.in
BREVO_SENDER_NAME=SidPrep
BREVO_DAILY_QUOTA_LIMIT=300
BREVO_DAILY_QUOTA_WARN_THRESHOLD=250

# Storage Driver (local or r2)
STORAGE_DRIVER=r2
STORAGE_LOCAL_DIR=./uploads

# Cloudflare R2 Credentials
R2_ENDPOINT=https://cbf7a4a2f0c78ae217205ffb1064ea54.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=1ffe7c761ee357af0998ece167f0ce6e
R2_SECRET_ACCESS_KEY=5a8e1264ec4ab149ecafb317eb1397ea8c0b9e9810109c87d8ca7733ba58e661
R2_BUCKET_NAME=sidprep-cdn-prod
R2_PUBLIC_DOMAIN=https://cdn.sidprep.in
R2_MONTHLY_QUOTA_BYTES=10737418240

# News Feed & Timezone
NEWS_TIMEZONE=Asia/Kolkata
NEWS_AUTO_PUBLISH_ENABLED=false
NEWS_AUTO_PUBLISH_CONFIDENCE_THRESHOLD=0.92

# Mobile Client API Base URL
EXPO_PUBLIC_API_URL=https://api.sidprep.in/v1
