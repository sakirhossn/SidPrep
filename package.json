{
  "name": "sidprep-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "SidPrep 2.0 Monorepo - Public Website, Admin CMS, Shared API & Worker",
  "scripts": {
    "dev:api": "pnpm --filter @sidprep/api dev",
    "dev:web": "pnpm --filter @sidprep/web dev",
    "dev:mobile": "pnpm --filter @sidprep/mobile start",
    "dev:mobile:web": "pnpm --filter @sidprep/mobile web",
    "dev:mock": "pnpm --filter @sidprep/mock-backend start",
    "build": "pnpm --filter @sidprep/contracts build && pnpm --filter @sidprep/design-tokens build && pnpm --filter @sidprep/api build && pnpm --filter @sidprep/web build",
    "test": "pnpm --filter @sidprep/contracts test && pnpm --filter @sidprep/api test",
    "security:scan": "node scripts/scan-secrets.mjs",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "pnpm -r exec rm -rf dist .next node_modules"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@12.16.1"
}
