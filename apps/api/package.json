{
  "name": "@sidprep/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "migrate:up": "tsx src/db/migrate.ts",
    "dispatch-admin-pass": "node dist/scripts/dispatch-admin-pass.js",
    "test": "node --test-concurrency=1 --test dist/test/*.test.js",
    "worker": "tsx src/worker/index.ts",
    "clean": "rm -rf dist",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "@electric-sql/pglite": "^0.5.15",
    "@fastify/cookie": "9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.5.0",
    "@fastify/static": "^7.0.4",
    "@node-rs/argon2": "^2.2.2",
    "@sidprep/contracts": "workspace:*",
    "@sidprep/design-tokens": "workspace:*",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^5.12.0",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.12.0",
    "sanitize-html": "^2.18.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@sidprep/config": "workspace:*",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.6",
    "@types/sanitize-html": "^2.16.2",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
